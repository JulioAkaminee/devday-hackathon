# Variáveis de ambiente do projeto
# Copie para .env e preencha — NUNCA comite o .env
# Detalhes de cada uma em docs/REGRAS.md (seção 7)

# IA via OpenRouter (chave dedicada, com limite de crédito)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-6-luna
OPENROUTER_FALLBACK_MODELS=google/gemini-3.1-flash-lite,anthropic/claude-haiku-5.5

# Assinatura dos QR de amizade (32+ caracteres aleatórios)
QR_SECRET=
# Acesso ao /admin
ADMIN_TOKEN=

# URL pública com HTTPS
PUBLIC_URL=
# Pasta do volume persistente
DATA_DIR=/data
PORT=3000
