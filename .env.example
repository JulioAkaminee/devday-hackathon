# Variáveis do Quebra-Gelo — copie para .env e preencha. NUNCA comite o .env.
# São só estas quatro: o servidor lê exatamente estes nomes (src/server/index.ts).

# Porta que o Express escuta dentro do contêiner
PORT=3000

# Pasta do snapshot do mundo (o volume persistente). Sem ela, os pets somem no redeploy
DATA_DIR=/data

# Endereço público com HTTPS. É o que o telão (/tela) usa para montar o QR de entrada
PUBLIC_URL=http://localhost:3000

# "production" serve o dist/ já construído; qualquer outro valor liga o Vite em modo dev
NODE_ENV=development
